rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Session Profiles (Firebase Anonymous Auth)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if
        request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role in ['admin', 'guru', 'siswa'] &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 100 &&
        request.resource.data.nama is string &&
        request.resource.data.nama.size() <= 160;
      allow delete: if false;
    }

    // Connection validation test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // School Profile
    match /school_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Teachers / GTK
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Students
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // TKA Submissions (dengan penguncian nilai resmi ujian TKA 1x)
    match /tka_submissions/{submissionId} {
      function isValidTkaSubmissionBase() {
        return
          request.resource.data.id is string &&
          request.resource.data.id.size() > 0 &&
          request.resource.data.id.size() <= 220 &&
          request.resource.data.studentId is string &&
          request.resource.data.studentId.size() > 0 &&
          request.resource.data.studentId.size() <= 120 &&
          request.resource.data.paket is string &&
          request.resource.data.paket.size() > 0 &&
          request.resource.data.paket.size() <= 160 &&
          (!('skorTotal' in request.resource.data) || (
            request.resource.data.skorTotal is number &&
            request.resource.data.skorTotal >= 0 &&
            request.resource.data.skorTotal <= 100
          ));
      }

      function isLockedTkaMapelPreserved(mapel) {
        return
          !(resource.data.lockedMapels is map) ||
          !(mapel in resource.data.lockedMapels) ||
          !(resource.data.lockedMapels[mapel] is map) ||
          resource.data.lockedMapels[mapel].sumberNilai != 'UJIAN_TKA' ||
          (
            request.resource.data.lockedMapels is map &&
            mapel in request.resource.data.lockedMapels &&
            request.resource.data.lockedMapels[mapel] is map &&
            request.resource.data.lockedMapels[mapel].sumberNilai == 'UJIAN_TKA' &&
            request.resource.data.lockedMapels[mapel].score == resource.data.lockedMapels[mapel].score &&
            request.resource.data.scoresPerMapel is map &&
            request.resource.data.scoresPerMapel[mapel] == resource.data.lockedMapels[mapel].score
          );
      }

      allow read: if true;
      allow create: if isValidTkaSubmissionBase();
      allow update: if
        isValidTkaSubmissionBase() &&
        (
          !(resource.data.isLocked == true && resource.data.sumberNilai == 'UJIAN_TKA') ||
          (
            request.resource.data.isLocked == true &&
            request.resource.data.sumberNilai == 'UJIAN_TKA' &&
            isLockedTkaMapelPreserved('Bahasa Indonesia') &&
            isLockedTkaMapelPreserved('Matematika') &&
            isLockedTkaMapelPreserved('IPAS') &&
            isLockedTkaMapelPreserved('Bahasa Inggris') &&
            isLockedTkaMapelPreserved('Koding dan Kecerdasan Artifisial (KKA)')
          )
        );
      allow delete: if true;
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // Cloud Backups
    match /backups/{backupId} {
      allow read: if true;
      allow write: if true;
    }

    // Central Multi-Device Online Sync Data
    match /school_data/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Ekstrakurikuler & Penilaian Ekskul
    match /ekskul/{ekskulId} {
      allow read: if true;
      allow write: if true;
    }
    match /penilaian_ekskul/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Assessments & Leger
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Bank Soal CBT & TKA & Hasil CBT Terisolasi per Siswa
    match /cbt_exams/{examId} {
      allow read: if true;
      allow write: if true;
    }
    match /cbt_results/{resultId} {
      allow read: if true;
      allow write: if true;
    }
    match /tka_questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings (Acak Soal, Acak Jawaban, dll)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Laporan 7 Kebiasaan Siswa
    match /laporan_kebiasaan/{laporanId} {
      allow read: if true;
      allow write: if true;
    }

    // Manajemen Nilai ASAJ, Pengaturan KOSP & Kelulusan
    match /settings_asaj/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /nilai_asaj/{nilaiId} {
      allow read: if true;
      allow write: if true;
    }
    match /siswa/{siswaId} {
      allow read: if true;
      allow write: if true;
    }

    // Portal Alumni & Arsip Lulusan
    match /alumni/{alumniId} {
      allow read: if true;
      allow write: if true;
    }

    // Perpustakaan Digital, Log Literasi & Kartu Peminjaman Barcode
    match /perpustakaan/{bookId} {
      allow read: if true;
      allow write: if true;
    }
    match /log_literasi/{logId} {
      allow read: if true;
      allow write: if true;
    }
    match /peminjaman_perpustakaan/{loanId} {
      allow read: if true;
      allow write: if true;
    }
    match /pinjaman/{pinjamanId} {
      allow read: if true;
      allow write: if true;
    }

    // Bank Media Ajar (PPT)
    match /media_ajar/{mediaId} {
      allow read: if true;
      allow write: if true;
    }

    // Asisten AI SARAH - Knowledge Base & Memori Pembelajaran Berkelanjutan
    match /sarah_knowledge_base/{docId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.judul is string &&
        request.resource.data.judul.size() > 0 &&
        request.resource.data.judul.size() <= 300 &&
        request.resource.data.kategori in ['RPP/Modul Ajar', 'Bank Soal', 'Materi Ajar', 'Kebijakan Sekolah'] &&
        request.resource.data.kelas is string &&
        request.resource.data.kelas.size() <= 40 &&
        request.resource.data.mata_pelajaran is string &&
        request.resource.data.mata_pelajaran.size() <= 120 &&
        request.resource.data.konten_ringkasan is string &&
        request.resource.data.konten_ringkasan.size() > 0 &&
        request.resource.data.konten_ringkasan.size() <= 40000;
      allow delete: if true;
    }

    // Asisten AI SARAH - Log Topik & Pertanyaan Siswa untuk Pemantauan Guru
    match /sarah_student_logs/{logId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() <= 120 &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() <= 150 &&
        request.resource.data.kelas is string &&
        request.resource.data.kelas.size() <= 40 &&
        request.resource.data.topik is string &&
        request.resource.data.topik.size() <= 200 &&
        request.resource.data.pertanyaan is string &&
        request.resource.data.pertanyaan.size() > 0 &&
        request.resource.data.pertanyaan.size() <= 3000;
      allow delete: if true;
    }

    // Asisten AI SARAH - Riwayat Percakapan Otomatis (Auto-Save Chat History)
    match /sarah_chat_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.user_id is string &&
        request.resource.data.user_id.size() > 0 &&
        request.resource.data.user_id.size() <= 160 &&
        request.resource.data.role in ['guru', 'siswa'] &&
        request.resource.data.judul_sesi is string &&
        request.resource.data.judul_sesi.size() > 0 &&
        request.resource.data.judul_sesi.size() <= 180;
      allow delete: if true;

      match /messages/{messageId} {
        allow read: if true;
        allow create, update: if
          exists(/databases/$(database)/documents/sarah_chat_sessions/$(sessionId)) &&
          request.resource.data.sender in ['user', 'sarah'] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 40000;
        allow delete: if true;
      }
    }

    // Penguncian Akses Ketat CBT & TKA - Dokumen Status Pengerjaan Ujian (${nisn}_${id_ujian})
    match /hasil_ujian/{docId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.id_ujian is string &&
        request.resource.data.id_ujian.size() > 0 &&
        request.resource.data.id_ujian.size() <= 160 &&
        request.resource.data.status in ['mengerjakan', 'selesai'] &&
        request.resource.data.category in ['cbt', 'tka'];
      allow delete: if true;
    }

    // Ruang Chat Privat Terisolasi Eksklusif Endi Soeprapto (`sarah_private_chats/endi_soeprapto`)
    match /sarah_private_chats/{ownerId} {
      allow read: if ownerId == 'endi_soeprapto';
      allow create, update: if
        ownerId == 'endi_soeprapto' &&
        request.resource.data.isolated == true;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if ownerId == 'endi_soeprapto';
        allow create, update: if
          ownerId == 'endi_soeprapto' &&
          request.resource.data.sender in ['user', 'sarah'] &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 40000;
        allow delete: if ownerId == 'endi_soeprapto';
      }
    }

    // Multi-Tenant Sekolah (schools/{npsn}) — Administrasi Pembelajaran & Supervisi
    match /schools/{npsn} {
      function isValidTenantId(id) {
        return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
      }

      function isValidLearningDoc(d) {
        return
          d.id is string && d.id.size() > 0 && d.id.size() <= 160 &&
          d.teacherId is string && d.teacherId.size() <= 160 &&
          d.teacherName is string && d.teacherName.size() > 0 && d.teacherName.size() <= 200 &&
          d.academicYear is string && d.academicYear.size() <= 40 &&
          d.kelas is string && d.kelas.size() <= 60 &&
          d.type in ['atp', 'prota', 'promes', 'modul_ajar', 'ppi_lkpd'] &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 400 &&
          d.driveUrl is string && d.driveUrl.size() <= 2000 &&
          d.status in ['Menunggu Verifikasi', 'Perlu Revisi', 'Disetujui & Terverifikasi (QR)'] &&
          d.updatedAt is string && d.updatedAt.size() <= 60 &&
          (!('contentDraft' in d) || (d.contentDraft is string && d.contentDraft.size() <= 20000)) &&
          (!('supervisorNote' in d) || (d.supervisorNote is string && d.supervisorNote.size() <= 2000)) &&
          (!('verifiedAt' in d) || (d.verifiedAt is string && d.verifiedAt.size() <= 60));
      }

      function isValidLearningJournal(d) {
        return
          d.id is string && d.id.size() > 0 && d.id.size() <= 160 &&
          d.teacherId is string && d.teacherId.size() <= 160 &&
          d.teacherName is string && d.teacherName.size() > 0 && d.teacherName.size() <= 200 &&
          d.academicYear is string && d.academicYear.size() <= 40 &&
          d.kelas is string && d.kelas.size() <= 60 &&
          d.date is string && d.date.size() > 0 && d.date.size() <= 30 &&
          d.mapel is string && d.mapel.size() > 0 && d.mapel.size() <= 150 &&
          d.objective is string && d.objective.size() > 0 && d.objective.size() <= 3000 &&
          d.achievement in ['Tercapai', 'Sebagian', 'Tertunda'] &&
          (!('tpCode' in d) || (d.tpCode is string && d.tpCode.size() <= 40)) &&
          (!('tpText' in d) || (d.tpText is string && d.tpText.size() <= 2000)) &&
          (!('attendanceSummary' in d) || (d.attendanceSummary is string && d.attendanceSummary.size() <= 1000)) &&
          (!('attendanceTotal' in d) || d.attendanceTotal is number) &&
          (!('attendancePresent' in d) || d.attendancePresent is number) &&
          (!('attendanceSakit' in d) || d.attendanceSakit is number) &&
          (!('attendanceIzin' in d) || d.attendanceIzin is number) &&
          (!('attendanceAlpa' in d) || d.attendanceAlpa is number) &&
          (!('attendanceRecorded' in d) || d.attendanceRecorded is bool) &&
          (!('reflection' in d) || (d.reflection is string && d.reflection.size() <= 3000)) &&
          d.createdAt is string && d.createdAt.size() <= 60;
      }

      function isValidLearningRemedial(d) {
        return
          d.id is string && d.id.size() > 0 && d.id.size() <= 160 &&
          d.teacherId is string && d.teacherId.size() <= 160 &&
          d.teacherName is string && d.teacherName.size() > 0 && d.teacherName.size() <= 200 &&
          d.academicYear is string && d.academicYear.size() <= 40 &&
          d.kelas is string && d.kelas.size() <= 60 &&
          d.studentName is string && d.studentName.size() > 0 && d.studentName.size() <= 200 &&
          d.subject is string && d.subject.size() > 0 && d.subject.size() <= 150 &&
          d.type in ['Remedial', 'Pengayaan', 'Pembinaan Khusus'] &&
          d.description is string && d.description.size() > 0 && d.description.size() <= 3000 &&
          (!('actionTaken' in d) || (d.actionTaken is string && d.actionTaken.size() <= 3000)) &&
          d.date is string && d.date.size() <= 30 &&
          d.createdAt is string && d.createdAt.size() <= 60;
      }

      function isValidSarahKnowledgeLink(d) {
        return
          d.id is string && d.id.size() > 0 && d.id.size() <= 160 &&
          d.title is string && d.title.size() > 0 && d.title.size() <= 300 &&
          d.url is string && d.url.size() > 0 && d.url.size() <= 2000 &&
          d.target in ['all', 'guru', 'siswa'] &&
          (!('summary' in d) || (d.summary is string && d.summary.size() <= 4000)) &&
          d.active is bool &&
          d.createdBy is string && d.createdBy.size() <= 160 &&
          (!('createdAt' in d) || (d.createdAt is string && d.createdAt.size() <= 60)) &&
          d.updatedAt is string && d.updatedAt.size() <= 60;
      }

      function isValidSanitizedExam(d) {
        return
          d.id is string && d.id.size() > 0 && d.id.size() <= 160 &&
          d.category in ['cbt', 'tka'] &&
          d.judul is string && d.judul.size() > 0 && d.judul.size() <= 300 &&
          d.mapel is string && d.mapel.size() > 0 && d.mapel.size() <= 160 &&
          d.soalList is list &&
          d.updatedAt is string && d.updatedAt.size() <= 60 &&
          (!('kelas' in d) || (d.kelas is string && d.kelas.size() <= 60)) &&
          (!('paketName' in d) || (d.paketName is string && d.paketName.size() <= 160)) &&
          (!('subPaket' in d) || (d.subPaket is string && d.subPaket.size() <= 80)) &&
          (!('durasiMenit' in d) || d.durasiMenit is number) &&
          (!('aktif' in d) || d.aktif is bool) &&
          (!('isSoalChunk' in d) || d.isSoalChunk is bool) &&
          (!('parentExamId' in d) || (d.parentExamId is string && d.parentExamId.size() <= 160)) &&
          (!('chunkIndex' in d) || d.chunkIndex is number) &&
          (!('soalChunkCount' in d) || d.soalChunkCount is number);
      }

      function isValidExamAnswerKey(d) {
        return
          d.examId is string && d.examId.size() > 0 && d.examId.size() <= 160 &&
          d.category in ['cbt', 'tka'] &&
          d.npsn is string && d.npsn == npsn &&
          d.keysByQuestionId is map &&
          d.updatedAt is string && d.updatedAt.size() <= 60 &&
          (!('judul' in d) || (d.judul is string && d.judul.size() <= 300)) &&
          (!('mapel' in d) || (d.mapel is string && d.mapel.size() <= 160)) &&
          (!('paketName' in d) || (d.paketName is string && d.paketName.size() <= 160));
      }

      allow read: if isValidTenantId(npsn);
      allow create, update: if isValidTenantId(npsn);
      allow delete: if false;

      match /learning_docs/{docId} {
        allow get: if isValidTenantId(npsn) && isValidTenantId(docId);
        allow list: if isValidTenantId(npsn);
        allow create, update: if isValidTenantId(npsn) && isValidTenantId(docId) && isValidLearningDoc(request.resource.data);
        allow delete: if isValidTenantId(npsn) && isValidTenantId(docId);
      }

      match /learning_journals/{journalId} {
        allow get: if isValidTenantId(npsn) && isValidTenantId(journalId);
        allow list: if isValidTenantId(npsn);
        allow create, update: if isValidTenantId(npsn) && isValidLearningJournal(request.resource.data) && isValidTenantId(journalId);
        allow delete: if isValidTenantId(npsn) && isValidTenantId(journalId);
      }

      match /learning_remedials/{recordId} {
        allow get: if isValidTenantId(npsn) && isValidTenantId(recordId);
        allow list: if isValidTenantId(npsn);
        allow create, update: if isValidTenantId(npsn) && isValidTenantId(recordId) && isValidLearningRemedial(request.resource.data);
        allow delete: if isValidTenantId(npsn) && isValidTenantId(recordId);
      }

      match /sarah_knowledge_links/{linkId} {
        allow get: if isValidTenantId(npsn) && isValidTenantId(linkId);
        allow list: if isValidTenantId(npsn);
        allow create, update: if isValidTenantId(npsn) && isValidTenantId(linkId) && isValidSarahKnowledgeLink(request.resource.data);
        allow delete: if isValidTenantId(npsn) && isValidTenantId(linkId);
      }

      // Soal CBT/TKA Bersih tanpa Kunci Jawaban (untuk browser siswa)
      match /exams/{examId} {
        allow get: if isValidTenantId(npsn) && isValidTenantId(examId);
        allow list: if isValidTenantId(npsn);
        allow create, update: if isValidTenantId(npsn) && isValidTenantId(examId) && isValidSanitizedExam(request.resource.data);
        allow delete: if isValidTenantId(npsn) && isValidTenantId(examId);
      }

      // Kunci Jawaban & Pembobotan Terproteksi (dipisahkan dari dokumen soal siswa)
      match /exam_answer_keys/{examId} {
        allow get: if isValidTenantId(npsn) && isValidTenantId(examId);
        allow list: if isValidTenantId(npsn);
        allow create, update: if isValidTenantId(npsn) && isValidTenantId(examId) && isValidExamAnswerKey(request.resource.data);
        allow delete: if isValidTenantId(npsn) && isValidTenantId(examId);
      }
    }
  }
}
