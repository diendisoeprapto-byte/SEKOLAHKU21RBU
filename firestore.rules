rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // School Profile
    match /school_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Teachers / GTK
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Students
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // TKA Submissions
    match /tka_submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // Cloud Backups
    match /backups/{backupId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
