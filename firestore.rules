rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection validation test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // School Profile
    match /school_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Teachers / GTK
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Students
    match /students/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // TKA Submissions
    match /tka_submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // Cloud Backups
    match /backups/{backupId} {
      allow read: if true;
      allow write: if true;
    }

    // Central Multi-Device Online Sync Data
    match /school_data/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Ekstrakurikuler & Penilaian Ekskul
    match /ekskul/{ekskulId} {
      allow read: if true;
      allow write: if true;
    }
    match /penilaian_ekskul/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Assessments & Leger
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if true;
    }

    // Bank Soal CBT & TKA
    match /cbt_exams/{examId} {
      allow read: if true;
      allow write: if true;
    }
    match /tka_questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings (Acak Soal, Acak Jawaban, dll)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Laporan 7 Kebiasaan Siswa
    match /laporan_kebiasaan/{laporanId} {
      allow read: if true;
      allow write: if true;
    }

    // Manajemen Nilai ASAJ, Pengaturan KOSP & Kelulusan
    match /settings_asaj/{settingId} {
      allow read: if true;
      allow write: if true;
    }
    match /nilai_asaj/{nilaiId} {
      allow read: if true;
      allow write: if true;
    }
    match /siswa/{siswaId} {
      allow read: if true;
      allow write: if true;
    }

    // Portal Alumni & Arsip Lulusan
    match /alumni/{alumniId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
