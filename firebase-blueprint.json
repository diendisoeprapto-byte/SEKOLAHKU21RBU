{
  "entities": {
    "SchoolProfile": {
      "title": "SchoolProfile",
      "description": "Profil identitas dan legalitas sekolah SDN Rawa Badak Utara 21",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "npsn": { "type": "string" },
        "kota": { "type": "string" },
        "provinsi": { "type": "string" },
        "alamat": { "type": "string" }
      },
      "required": ["name", "npsn"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Data GTK Guru dan Tenaga Kependidikan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "nip": { "type": "string" },
        "statusPegawai": { "type": "string" },
        "penugasan": { "type": "string" },
        "username": { "type": "string" }
      },
      "required": ["id", "nama", "penugasan"]
    },
    "Student": {
      "title": "Student",
      "description": "Data peserta didik sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "nisn": { "type": "string" },
        "kelas": { "type": "string" },
        "agama": { "type": "string" }
      },
      "required": ["id", "nama", "nisn", "kelas"]
    },
    "TKASubmission": {
      "title": "TKASubmission",
      "description": "Lembar jawaban dan hasil nilai ujian TKA siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "nisn": { "type": "string" },
        "kelas": { "type": "string" },
        "paket": { "type": "string" },
        "skorTotal": { "type": "number" },
        "predikat": { "type": "string" },
        "status": { "type": "string" },
        "tanggalUjian": { "type": "string" },
        "benarHots": { "type": "number" },
        "totalHots": { "type": "number" },
        "durasiDetik": { "type": "number" },
        "sumberNilai": { "type": "string", "enum": ["UJIAN_TKA", "INPUT_MANUAL"] },
        "isLocked": { "type": "boolean" },
        "waktuTerkunci": { "type": "string" },
        "lockedMapels": { "type": "object" }
      },
      "required": ["id", "studentId", "paket", "skorTotal"]
    },
    "CBTResult": {
      "title": "CBTResult",
      "description": "Dokumen hasil pengerjaan ujian CBT terisolasi per siswa (${examId}_${nisn})",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "nisn": { "type": "string" },
        "kelas": { "type": "string" },
        "nilai": { "type": "number" },
        "skor": { "type": "number" },
        "benarHots": { "type": "number" },
        "totalHots": { "type": "number" },
        "durasiDetik": { "type": "number" },
        "statusPengerjaan": { "type": "string", "enum": ["sedang_mengerjakan", "selesai"] }
      },
      "required": ["examId", "studentId", "nilai"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Rekam presensi harian siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" },
        "time": { "type": "string" }
      },
      "required": ["studentId", "date", "status"]
    },
    "Backup": {
      "title": "Backup",
      "description": "Snapshot data cadangan sistem di cloud",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "version": { "type": "string" },
        "dataJson": { "type": "string" }
      },
      "required": ["id", "timestamp", "dataJson"]
    },
    "Alumni": {
      "title": "Alumni",
      "description": "Data alumni, buku induk digital, riwayat nilai kelas 1-6, kelulusan, dan arsip dokumen rapor/ijazah/SKL",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "biodata": { "type": "object" },
        "kelulusan": { "type": "object" },
        "riwayatNilai": { "type": "object" },
        "dokumen": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "biodata", "kelulusan"]
    },
    "PerpustakaanBook": {
      "title": "PerpustakaanBook",
      "description": "Metadata katalog buku Perpustakaan Digital (Metadata-Only tanpa Firebase Storage)",
      "type": "object",
      "properties": {
        "judul": { "type": "string" },
        "penulis": { "type": "string" },
        "kategori": { "type": "string" },
        "kelas": { "type": "string" },
        "cover_url": { "type": "string" },
        "file_url": { "type": "string" },
        "sumber": { "type": "string" },
        "dibaca_count": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["judul", "penulis", "kategori", "kelas", "file_url"]
    },
    "LogLiterasi": {
      "title": "LogLiterasi",
      "description": "Riwayat log baca buku siswa untuk pemeringkatan Pembaca Terajin / Duta Literasi",
      "type": "object",
      "properties": {
        "nisn": { "type": "string" },
        "nama_siswa": { "type": "string" },
        "kelas": { "type": "string" },
        "buku_id": { "type": "string" },
        "judul_buku": { "type": "string" },
        "kategori_buku": { "type": "string" },
        "waktu_baca": { "type": "string", "format": "date-time" },
        "tanggal": { "type": "string" },
        "bulan_tahun": { "type": "string" }
      },
      "required": ["nisn", "nama_siswa", "kelas", "buku_id", "judul_buku", "tanggal", "bulan_tahun"]
    },
    "PeminjamanPerpustakaan": {
      "title": "PeminjamanPerpustakaan",
      "description": "Data peminjaman buku siswa menggunakan Kartu Absensi Barcode",
      "type": "object",
      "properties": {
        "student_id": { "type": "string" },
        "barcode_id": { "type": "string" },
        "nisn": { "type": "string" },
        "nama_siswa": { "type": "string" },
        "kelas": { "type": "string" },
        "buku_id": { "type": "string" },
        "judul_buku": { "type": "string" },
        "kode_eksemplar": { "type": "string" },
        "tanggal_pinjam": { "type": "string" },
        "tanggal_kembali_rencana": { "type": "string" },
        "tanggal_dikembalikan": { "type": "string" },
        "status": { "type": "string" },
        "petugas": { "type": "string" },
        "catatan": { "type": "string" }
      },
      "required": ["barcode_id", "nisn", "nama_siswa", "judul_buku", "tanggal_pinjam", "status"]
    },
    "MediaAjar": {
      "title": "MediaAjar",
      "description": "Katalog tautan slide PowerPoint (PPTX) / PDF Google Drive per kelas pada fitur Bank Media Ajar",
      "type": "object",
      "properties": {
        "judul": { "type": "string" },
        "kelas": { "type": "string" },
        "mapel": { "type": "string" },
        "pertemuan": { "type": "string" },
        "drive_url": { "type": "string" },
        "embed_url": { "type": "string" },
        "guru_nama": { "type": "string" },
        "guru_uid": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["judul", "kelas", "mapel", "pertemuan", "drive_url", "embed_url", "guru_nama", "guru_uid"]
    },
    "SarahKnowledgeItem": {
      "title": "SarahKnowledgeItem",
      "description": "Basis pengetahuan kurasi guru untuk asisten AI SARAH (RAG pembelajaran berkelanjutan)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "judul": { "type": "string" },
        "kategori": { "type": "string" },
        "kelas": { "type": "string" },
        "mata_pelajaran": { "type": "string" },
        "konten_ringkasan": { "type": "string" },
        "sumber": { "type": "string" },
        "disetujui_oleh": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "judul", "kategori", "kelas", "mata_pelajaran", "konten_ringkasan", "sumber", "disetujui_oleh"]
    },
    "SarahStudentLog": {
      "title": "SarahStudentLog",
      "description": "Log topik & pertanyaan siswa kepada SARAH untuk pemantauan guru kelas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "nisn": { "type": "string" },
        "kelas": { "type": "string" },
        "mata_pelajaran": { "type": "string" },
        "topik": { "type": "string" },
        "pertanyaan": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentId", "studentName", "kelas", "topik", "pertanyaan"]
    },
    "SarahChatSession": {
      "title": "SarahChatSession",
      "description": "Sesi riwayat percakapan otomatis (Auto-Save) asisten SARAH per pengguna",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "role": { "type": "string", "enum": ["guru", "siswa"] },
        "judul_sesi": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "role", "judul_sesi"]
    },
    "SarahChatMessage": {
      "title": "SarahChatMessage",
      "description": "Pesan dalam sub-koleksi riwayat chat SARAH",
      "type": "object",
      "properties": {
        "sender": { "type": "string", "enum": ["user", "sarah"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["sender", "text"]
    },
    "HasilUjian": {
      "title": "HasilUjian",
      "description": "Status pengerjaan & hasil ujian CBT/TKA siswa dengan kunci ${nisn}_${id_ujian} untuk aturan penguncian akses ketat SARAH",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nisn": { "type": "string" },
        "id_ujian": { "type": "string" },
        "studentId": { "type": "string" },
        "nama_siswa": { "type": "string" },
        "kelas": { "type": "string" },
        "category": { "type": "string", "enum": ["cbt", "tka"] },
        "mapel": { "type": "string" },
        "paketName": { "type": "string" },
        "status": { "type": "string", "enum": ["mengerjakan", "selesai"] },
        "skor": { "type": "number" },
        "no_soal_betul": { "type": "array" },
        "no_soal_salah": { "type": "array" }
      },
      "required": ["id_ujian", "status", "category"]
    },
    "SarahPrivateChat": {
      "title": "SarahPrivateChat",
      "description": "Ruang percakapan privat terisolasi khusus akun Endi Soeprapto",
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "isolated": { "type": "boolean" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["owner", "isolated"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Sesi profil peran pengguna aktif (Firebase Anonymous Auth UID)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "guru", "siswa"] },
        "username": { "type": "string" },
        "nama": { "type": "string" },
        "kelas": { "type": "string" },
        "nisn": { "type": "string" },
        "detail": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "username", "nama"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Dokumen konfigurasi sistem (tampilan login, kredensial admin, pengaturan ujian CBT)",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" }
      }
    },
    "LearningAdminDoc": {
      "title": "LearningAdminDoc",
      "description": "Dokumen perangkat ajar guru (ATP, Prota, Promes, Modul Ajar, PPI & LKPD Adaptif) terisolasi per sekolah NPSN",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "teacherId": { "type": "string", "maxLength": 160 },
        "teacherName": { "type": "string", "maxLength": 200 },
        "academicYear": { "type": "string", "maxLength": 40 },
        "kelas": { "type": "string", "maxLength": 60 },
        "type": { "type": "string", "enum": ["atp", "prota", "promes", "modul_ajar", "ppi_lkpd"] },
        "title": { "type": "string", "maxLength": 400 },
        "driveUrl": { "type": "string", "maxLength": 2000 },
        "contentDraft": { "type": "string", "maxLength": 20000 },
        "status": { "type": "string", "enum": ["Menunggu Verifikasi", "Perlu Revisi", "Disetujui & Terverifikasi (QR)"] },
        "supervisorNote": { "type": "string", "maxLength": 2000 },
        "verifiedAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "teacherId", "teacherName", "academicYear", "kelas", "type", "title", "driveUrl", "status", "updatedAt"]
    },
    "TeachingJournal": {
      "title": "TeachingJournal",
      "description": "Jurnal mengajar harian (agenda kelas) terintegrasi kehadiran murid & Tujuan Pembelajaran (TP) kurikulum",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "teacherId": { "type": "string", "maxLength": 160 },
        "teacherName": { "type": "string", "maxLength": 200 },
        "academicYear": { "type": "string", "maxLength": 40 },
        "kelas": { "type": "string", "maxLength": 60 },
        "date": { "type": "string", "maxLength": 30 },
        "mapel": { "type": "string", "maxLength": 150 },
        "tpCode": { "type": "string", "maxLength": 40 },
        "tpText": { "type": "string", "maxLength": 2000 },
        "objective": { "type": "string", "maxLength": 3000 },
        "attendanceTotal": { "type": "number" },
        "attendancePresent": { "type": "number" },
        "attendanceSakit": { "type": "number" },
        "attendanceIzin": { "type": "number" },
        "attendanceAlpa": { "type": "number" },
        "attendanceSummary": { "type": "string", "maxLength": 1000 },
        "attendanceRecorded": { "type": "boolean" },
        "achievement": { "type": "string", "enum": ["Tercapai", "Sebagian", "Tertunda"] },
        "reflection": { "type": "string", "maxLength": 3000 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "teacherId", "teacherName", "academicYear", "kelas", "date", "mapel", "objective", "achievement", "createdAt"]
    },
    "StudentRemedialRecord": {
      "title": "StudentRemedialRecord",
      "description": "Catatan tindak lanjut remedial, pengayaan, dan pembinaan khusus siswa per sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "teacherId": { "type": "string", "maxLength": 160 },
        "teacherName": { "type": "string", "maxLength": 200 },
        "academicYear": { "type": "string", "maxLength": 40 },
        "kelas": { "type": "string", "maxLength": 60 },
        "studentName": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["Remedial", "Pengayaan", "Pembinaan Khusus"] },
        "description": { "type": "string", "maxLength": 3000 },
        "actionTaken": { "type": "string", "maxLength": 3000 },
        "date": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "teacherId", "teacherName", "academicYear", "kelas", "studentName", "subject", "type", "description", "date", "createdAt"]
    },
    "SarahKnowledgeLink": {
      "title": "SarahKnowledgeLink",
      "description": "Daftar link sumber informasi/rujukan eksternal kurasi Admin atau Endi Soeprapto untuk basis pengetahuan AI SARAH",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160 },
        "title": { "type": "string", "maxLength": 300 },
        "url": { "type": "string", "maxLength": 2000 },
        "target": { "type": "string", "enum": ["all", "guru", "siswa"] },
        "summary": { "type": "string", "maxLength": 4000 },
        "active": { "type": "boolean" },
        "createdBy": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "title", "url", "target", "active", "createdBy", "updatedAt"]
    }
  },
  "firestore": {
    "/school_profiles/{profileId}": {
      "schema": "SchoolProfile",
      "description": "Dokumen profil sekolah"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Daftar guru dan tenaga kependidikan"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Daftar peserta didik"
    },
    "/tka_submissions/{submissionId}": {
      "schema": "TKASubmission",
      "description": "Hasil ujian TKA siswa"
    },
    "/cbt_results/{resultId}": {
      "schema": "CBTResult",
      "description": "Hasil ujian CBT terisolasi per siswa per ujian"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Data absensi harian siswa"
    },
    "/backups/{backupId}": {
      "schema": "Backup",
      "description": "Data cadangan cloud sistem"
    },
    "/alumni/{alumniId}": {
      "schema": "Alumni",
      "description": "Arsip digital lulusan & buku induk alumni SDN Rawa Badak Utara 21"
    },
    "/perpustakaan/{bookId}": {
      "schema": "PerpustakaanBook",
      "description": "Katalog buku digital SDN Rawa Badak Utara 21"
    },
    "/log_literasi/{logId}": {
      "schema": "LogLiterasi",
      "description": "Log aktivitas membaca siswa harian untuk Duta Literasi"
    },
    "/peminjaman_perpustakaan/{loanId}": {
      "schema": "PeminjamanPerpustakaan",
      "description": "Catatan peminjaman buku menggunakan Kartu Absensi Barcode siswa (legacy)"
    },
    "/pinjaman/{pinjamanId}": {
      "schema": "PeminjamanPerpustakaan",
      "description": "Catatan checkout peminjaman buku perpustakaan yang menautkan barcode kartu absensi/perpustakaan siswa ke ID buku"
    },
    "/media_ajar/{mediaId}": {
      "schema": "MediaAjar",
      "description": "Daftar slide materi pembelajaran (PPTX/PDF Google Drive) terfilter per kelas 1 sampai 6"
    },
    "/sarah_knowledge_base/{docId}": {
      "schema": "SarahKnowledgeItem",
      "description": "Basis pengetahuan & memori pembelajaran berkelanjutan asisten SARAH"
    },
    "/sarah_student_logs/{logId}": {
      "schema": "SarahStudentLog",
      "description": "Log pertanyaan siswa pada widget Tanya SARAH untuk pantauan guru"
    },
    "/sarah_chat_sessions/{sessionId}": {
      "schema": "SarahChatSession",
      "description": "Sesi riwayat percakapan otomatis SARAH per akun pengguna (dibatasi 20 sesi terakhir)"
    },
    "/sarah_chat_sessions/{sessionId}/messages/{messageId}": {
      "schema": "SarahChatMessage",
      "description": "Sub-koleksi isi pesan percakapan SARAH per sesi (dibatasi 30 pesan terakhir)"
    },
    "/hasil_ujian/{docId}": {
      "schema": "HasilUjian",
      "description": "Status pengerjaan ujian CBT/TKA (${nisn}_${id_ujian}) untuk validasi penguncian akses ketat SARAH"
    },
    "/sarah_private_chats/{ownerId}": {
      "schema": "SarahPrivateChat",
      "description": "Ruang obrolan privat terisolasi eksklusif untuk Endi Soeprapto"
    },
    "/sarah_private_chats/{ownerId}/messages/{messageId}": {
      "schema": "SarahChatMessage",
      "description": "Sub-koleksi isi pesan privat eksklusif Endi Soeprapto"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Dokumen sesi profil peran pengguna aktif terikat Firebase Auth UID"
    },
    "/settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Konfigurasi global aplikasi SERBU 21 (tampilan login, kredensial admin, pengaturan CBT)"
    },
    "/schools/{npsn}/learning_docs/{docId}": {
      "schema": "LearningAdminDoc",
      "description": "Repositori perangkat ajar (ATP, Prota, Promes, Modul Ajar, PPI) terisolasi per NPSN sekolah"
    },
    "/schools/{npsn}/learning_journals/{journalId}": {
      "schema": "TeachingJournal",
      "description": "Jurnal mengajar harian terintegrasi kehadiran & TP per NPSN sekolah"
    },
    "/schools/{npsn}/learning_remedials/{recordId}": {
      "schema": "StudentRemedialRecord",
      "description": "Catatan tindak lanjut remedial & pembinaan siswa per NPSN sekolah"
    },
    "/schools/{npsn}/sarah_knowledge_links/{linkId}": {
      "schema": "SarahKnowledgeLink",
      "description": "Basis pengetahuan link sumber rujukan AI SARAH per NPSN sekolah"
    }
  }
}
